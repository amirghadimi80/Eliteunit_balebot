# EliteUniteTime Bot Configuration
# Copy this file to .env and fill in your actual values

# ===========================
# BALE BOT CONFIGURATION
# ===========================
# Your Bale API Token from @BaleBot
BALE_API_TOKEN=2029474166:MzkMDmPbKHhF6JT0Dn9AYuq84mnTq20L1wk

# Group chat ID(s) where reports will be posted (comma-separated for multiple groups)
BALE_GROUP_ID=your_group_id_here

# Comma-separated list of admin user IDs
BALE_ADMIN_IDS=admin_id_1,admin_id_2,admin_id_3

# ===========================
# SYSTEM SETTINGS
# ===========================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum main working hours per day
MAX_MAIN_HOURS=12

# Maximum side working hours per day
MAX_SIDE_HOURS=8

# ===========================
# DASHBOARD SETTINGS
# ===========================
# Password to access the web dashboard
DASHBOARD_PASSWORD=admin1234

# Secret key for Flask sessions (change this!)
DASHBOARD_SECRET_KEY=change-this-to-a-random-secret

# Port for the dashboard (default: 5000)
DASHBOARD_PORT=5000

# Enable debug mode (true/false)
DASHBOARD_DEBUG=false
